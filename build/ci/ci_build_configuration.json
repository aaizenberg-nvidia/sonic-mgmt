{
  "author": "system-sw-dev-ops-support@mellanox.com",
  "notify": "GERRIT_PATCHSET_UPLOADER_EMAIL,GERRIT_CHANGE_OWNER_EMAIL,bcc:NBU-system-sw-dev-ops-support@exchange.nvidia.com",
  "timeout": "7",
  "control_file": "/auto/sw_system_project/devops/sw-r2d2-bot/ngci_control_files/sonic_mgmt_control_file.yaml",
  "properties": [
    "default_propertiesFile=/auto/sw_system_release/ci/general/ngci_properties_v2/swfw_default_params.properties",
    "gerrit_propertiesFile=/auto/sw_system_release/ci/general/ngci_properties_v2/gerrit_git-nbu-sw.properties",
    "build_propertiesFile=build/common/build.properties",
    "PIPELINE_FORCE_CLEAN=true",
    "PRIORITY_NUMBER=4",
    "TARBALL_NAME=SONIC_MGMT_TAR.db.1.tgz",
    "OFFICIAL_TESTS=SONIC_MGMT",
    "SIMX_ON_FAILURE=stop",
    "AIR_ON_FAILURE=continue",
    "CI_SONIC_SPC_SETUP_CHIP_TYPE=SPC",
    "CI_SONIC_SIMX_SPC_SETUP_CHIP_TYPE=SPC",
    "CI_SONIC_AIR_SPC_SETUP_CHIP_TYPE=SPC"
  ],
  "agentConfig": [
    {
      "type": "pod",
      "libraryResource": "devops/k8s/podTemplates/il/products/tools/mars/mini-mars-pod-template.yaml",
      "label": "POD_MARS",
      "parameters": [
        {
          "binding": {"variables": {
              "mini_mars_image": "harbor.mellanox.com/sonic/sonic_mars_docker:latest"
            }
          }
        }
      ]
    },
    {
      "type": "pod",
      "libraryResource": "devops/k8s/podTemplates/il/products/tools/mars/mini-mars-pod-template.yaml",
      "label": "POD_MARS_AIR",
      "parameters": [
        {
          "binding": {"variables": {
              "mini_mars_image": "harbor.mellanox.com/sonic/sonic_mars_docker:rocky_keepalive"
            }
          }
        }
      ]
    }
  ],
  "phases": [
    {
      "phase_1": [
        {
          "name": "Pre Gerrit Validation",
          "module": "com.mellanox.jenkins.generic_modules.GerritValidation",
          "category": "Pre Build Check",
          "parameters": {
            "BRANCH_LOCK_CHECK": "${BRANCH_LOCK_CHECK}",
            "RELATED_CHANGES": "${RELATED_CHANGES}",
            "COMMIT_MSG_MANDATORY_WORDS": "${COMMIT_MSG_MANDATORY_WORDS}"
          },
          "node": "SONIC_LITE",
          "skip": false,
          "on_failure": "stop",
          "out_of_mail": true
        }
      ]
    },
    {
      "phase_2": [
        {
          "name": "Clone Sonic-mgmt",
          "module": "com.mellanox.jenkins.generic_modules.Checkout",
          "category": "Pre BAT",
          "node": "SONIC_LITE",
          "parameters": {
            "CLONE_PATH": "${PROJECT_NAME}",
            "GIT_REPOSITORY": "${GIT_REPOSITORY}"
          },
          "skip": false,
          "on_failure": "stop",
          "out_of_mail": true
        },
        {
          "name": "Clone General",
          "category": "Pre BAT",
          "module": "com.mellanox.jenkins.generic_modules.Checkout",
          "node": "SONIC_LITE",
          "parameters": {
            "CLONE_PATH_TMP": "general",
            "CREDENTIALSID": "gitlab-user-password",
            "GIT_REPOSITORY": "https://gitlab-master.nvidia.com/nbu-sws/Tools/general.git",
            "BRANCH_NAME": "${GENERAL_SHA1}"
          },
          "skip": false,
          "on_failure": "stop",
          "out_of_mail": "true"
        },
        {
          "name": "Components Match",
          "module": "com.mellanox.jenkins.generic_modules.ComponentMatch",
          "category": "Pre BAT",
          "node": "SONIC_LITE",
          "parameters": {
            "MAP_FILE": "${PROJECT_NAME}/build/ci/file_mapping.yaml",
            "VERBOSE": true
          },
          "skip": false,
          "on_failure": "stop"
        },
        {
          "name": "Validation",
          "module": "build/ci/pre_ci_validation.groovy",
          "category": "Pre BAT",
          "node": "SONIC_LITE",
          "parameters": {},
          "skip": false,
          "on_failure": "stop",
          "out_of_mail": true
        },
        {
          "parallel_build": [
            {
              "name": "Beautify",
              "module": "com.mellanox.jenkins.generic_modules.Beautify",
              "category": "Pre BAT",
              "node": "SONIC_LITE",
              "parameters": {
                "beautifier_params": "--ignore build/ci/config/beautify/beautifier_ignore_list.txt --config build/ci/config/beautify"
              },
              "skip": "${SKIP_BEAUTIFIER}",
              "on_failure": "stop"
            },
            {
              "name": "Spell Check",
              "module": "com.mellanox.jenkins.generic_modules.SpellCheck",
              "category": "Pre BAT",
              "node": "SONIC_LITE",
              "parameters": {
                "create_dictionary": "/auto/sw_system_project/tools/aspell_exceptions",
                "spell_check_params": "--dictionary-list sonic-mgmt,generic --ignore build/ci/config/spellcheck/spellcheck_ignore_list.txt"
              },
              "skip": "${SKIP_SPELLCHECK}",
              "on_failure": "stop"
            }
          ]
        },
        {
          "name": "Handle Components Match",
          "module": "${nfs_dir}/build/ci/handle_component.groovy",
          "category": "Pre BAT",
          "node": "SONIC_LITE",
          "parameters": {},
          "skip": false,
          "on_failure": "stop",
          "out_of_mail": false
        },
        {
          "name": "Check BAT compatibility",
          "module": "/auto/sw_system_release/ci/sonic_devops/build/common/bat_compatibility.groovy",
          "category": "Pre BAT",
          "node": "SONIC_LITE",
          "parameters": {
            "readme_folder": "${README_PATH}"
          },
          "skip": "${SKIP_SIMX}",
          "on_failure": "stop",
          "out_of_mail": true
        },
        {
          "name": "Create tarball",
          "module": "com.mellanox.jenkins.generic_modules.RunCmd",
          "category": "Pre BAT",
          "node": "SONIC_LITE",
          "parameters": {
            "cmd": "cd ${nfs_dir}; tar -zcvf ${nfs_dir}/${TARBALL_NAME} sonic-mgmt"
          },
          "skip": false,
          "on_failure": "stop",
          "out_of_mail": true
        }
      ]
    },
    {
      "phase_3": [
        {
          "name": "Allocate setup AIR SPC6 COMM T1",
          "module": "com.mellanox.jenkins.generic_modules.AllocateSetups",
          "category": "Allocate setups",
          "container": "mini-mars:POD_MARS_AIR@AIR_SPC6_COMM",
          "parameters": {
            "queue_id": "devops_sonic_ci_air_spc6_comm_t1",
            "priority": "${PRIORITY_NUMBER}",
            "with_labels": "CI_SONIC_AIR_SPC6_COMM",
            "device_var": "SWITCH_SALAMANDRA",
            "setup_var": "CI_SONIC_AIR_SPC6_COMM_SETUP",
            "setup_requirements": "group_name:Sagi,sub_group:SONiC_AIR_CI,setup_status:enable"
          },
          "skip": "${SKIP_AIR}",
          "on_failure": "ignore",
          "out_of_mail": true
        },
        {
          "name": "Allocate setup AIR SPC6 COMM T0",
          "module": "com.mellanox.jenkins.generic_modules.AllocateSetups",
          "category": "Allocate setups",
          "container": "mini-mars:POD_MARS_AIR@AIR_SPC6_COMM_T0",
          "parameters": {
            "queue_id": "devops_sonic_ci_air_spc6_comm_t1",
            "priority": "${PRIORITY_NUMBER}",
            "with_labels": "CI_SONIC_AIR_SPC6_COMM",
            "device_var": "SWITCH_SALAMANDRA",
            "setup_var": "CI_SONIC_AIR_SPC6_COMM_T0_SETUP",
            "setup_requirements": "group_name:Sagi,sub_group:SONiC_AIR_CI,setup_status:enable"
          },
          "skip": "${SKIP_AIR}",
          "on_failure": "ignore",
          "out_of_mail": true
        },
        {
          "name": "Allocate setup SPC Community",
          "module": "com.mellanox.jenkins.generic_modules.AllocateSetups",
          "category": "Allocate setups",
          "container": "mini-mars:POD_MARS@COMMUNITY_SPC",
          "parameters": {
            "queue_id": "devops_sonic_ci_community_spc",
            "priority": "${PRIORITY_NUMBER}",
            "setup_type": "CI_SONIC_COMMUNITY_SPC",
            "setup_var": "CI_SONIC_COMMUNITY_SPC_SETUP",
            "device_var": "SWITCH_PANTHER1",
            "setup_requirements": "group_name:Sagi,sub_group:SONIC_CI,setup_status:enable"
          },
          "skip": "${SKIP_COMMUNITY_REGRESSION}",
          "on_failure": "stop",
          "out_of_mail": true
        },
        {
          "name": "Allocate setup SPC",
          "module": "${nfs_dir}/general/build/smart_allocate_setup/smart_allocate_setup.groovy",
          "category": "Allocate setups",
          "container": "mini-mars:POD_MARS@SPC",
          "parameters": {
            "priority": "${PRIORITY_NUMBER}",
            "setup_var": "CI_SONIC_SPC_SETUP",
            "yaml_path": "${nfs_dir}/build/common/queue_physical_info.yaml",
            "setup_requirements": "group_name:Sagi,sub_group:SONIC_CI,setup_status:enable"
          },
          "skip": "${SKIP_SONIC_HW_SPC_BAT}",
          "on_failure": "stop",
          "out_of_mail": true
        },
        {
          "name": "Allocate setup SIMX SPC",
          "module": "${nfs_dir}/general/build/smart_allocate_setup/smart_allocate_setup.groovy",
          "category": "Allocate setups",
          "container": "mini-mars:POD_MARS@SIMX_SPC",
          "parameters": {
            "priority": "${PRIORITY_NUMBER}",
            "setup_var": "CI_SONIC_SIMX_SPC_SETUP",
            "yaml_path": "${nfs_dir}/build/common/queue_simx_info.yaml",
            "setup_requirements": "group_name:Sagi,sub_group:SONIC_SIMX_CI,setup_status:enable"
          },
          "skip": "${SKIP_SONIC_SIMX_SPC_BAT}",
          "on_failure": "continue",
          "out_of_mail": true
        },
        {
          "name": "Allocate setup SmartSwitch",
          "module": "com.mellanox.jenkins.generic_modules.AllocateSetups",
          "category": "Allocate setups",
          "container": "mini-mars:POD_MARS@SS",
          "parameters": {
            "queue_id": "devops_sonic_ci_ss",
            "priority": "${PRIORITY_NUMBER}",
            "setup_type": "CI_SONIC_SS",
            "setup_var": "CI_SONIC_SS_SETUP",
            "device_var": "SERVER",
            "setup_requirements": "group_name:Sagi,sub_group:SONIC_CI,setup_status:enable"
          },
          "skip": "${SKIP_SONIC_HW_SS_BAT}",
          "on_failure": "stop",
          "out_of_mail": true
        },
        {
          "name": "Allocate setup QTM4",
          "module": "com.mellanox.jenkins.generic_modules.AllocateSetups",
          "category": "Allocate setups",
          "container": "mini-mars:POD_MARS@QTM4",
          "parameters": {
            "queue_id": "devops_nvos_ci_qtm4",
            "priority": "${PRIORITY_NUMBER}",
            "setup_type": "NVOS_CHIPSIM_SONIC_MGMT_QTM4",
            "setup_var": "NVOS_CHIPSIM_SONIC_MGMT_QTM4_SETUP",
            "device_var": "SWITCH_ROSALIND",
            "setup_requirements": "group_name:Sagi,sub_group:CI,setup_status:enable"
          },
          "skip": "${SKIP_NVOS_BAT}",
          "on_failure": "stop",
          "out_of_mail": true
        },
        {
          "name": "Deploy Community SPC",
          "module": "/auto/sw_system_release/ci/sonic_devops/build/ci/bat.groovy",
          "category": "BAT",
          "container": "mini-mars:POD_MARS@COMMUNITY_SPC",
          "parameters": {
            "row": "ETH_COMMUNITY",
            "column": "SPC",
            "global_conf": "${MARS_GLOBAL_CONF}",
            "local_conf": "${MARS_LOCAL_CONF}",
            "setup_id": "${CI_SONIC_COMMUNITY_SPC_SETUP}",
            "setup_conf_file_path": "${MARS_CONF_BASE}/${CI_SONIC_COMMUNITY_SPC_SETUP}/",
            "base_version": "${SONIC_BIN}",
            "test_type": "REGRESSION",
            "sonic_mgmt_repo_url": "${nfs_dir}",
            "mars_release_version": "${MARS_RELEASE_VERSION}",
            "test_name": "deploy",
            "run_in_container": true
          },
          "skip": "${SKIP_COMMUNITY_REGRESSION}",
          "on_failure": "stop",
          "out_of_mail": false
        },
        {
          "name": "Test Community SPC",
          "module": "/auto/sw_system_release/ci/sonic_devops/build/ci/bat.groovy",
          "category": "BAT",
          "container": "mini-mars:POD_MARS@COMMUNITY_SPC",
          "parameters": {
            "row": "ETH_COMMUNITY",
            "column": "SPC",
            "global_conf": "${MARS_GLOBAL_CONF}",
            "local_conf": "${MARS_LOCAL_CONF}",
            "setup_id": "${CI_SONIC_COMMUNITY_SPC_SETUP}",
            "setup_conf_file_path": "${MARS_CONF_BASE}/${CI_SONIC_COMMUNITY_SPC_SETUP}/",
            "base_version": "${SONIC_BIN}",
            "test_type": "REGRESSION",
            "mars_release_version": "${MARS_RELEASE_VERSION}",
            "sonic_mgmt_repo_url": "${nfs_dir}",
            "test_name": "test",
            "run_in_container": true
          },
          "skip": "${SKIP_COMMUNITY_REGRESSION}",
          "on_failure": "stop",
          "out_of_mail": false
        },
        {
          "name": "Deploy SPC",
          "module": "/auto/sw_system_release/ci/sonic_devops/build/ci/bat.groovy",
          "category": "BAT",
          "container": "mini-mars:POD_MARS@SPC",
          "parameters": {
            "row": "ETH",
            "column": "${CI_SONIC_SPC_SETUP_CHIP_TYPE}",
            "global_conf": "${MARS_GLOBAL_CONF}",
            "local_conf": "${MARS_LOCAL_CONF}",
            "setup_id": "${CI_SONIC_SPC_SETUP}",
            "setup_conf_file_path": "${MARS_CONF_BASE}/${CI_SONIC_SPC_SETUP}/",
            "base_version": "${SONIC_BIN}",
            "test_type": "CI",
            "sonic_mgmt_repo_url": "${nfs_dir}",
            "mars_release_version": "${MARS_RELEASE_VERSION}",
            "test_name": "deploy",
            "run_in_container": true
          },
          "skip": "${SKIP_SONIC_HW_SPC_BAT}",
          "on_failure": "stop",
          "out_of_mail": false
        },
        {
          "name": "Test SPC",
          "module": "/auto/sw_system_release/ci/sonic_devops/build/ci/bat.groovy",
          "category": "BAT",
          "container": "mini-mars:POD_MARS@SPC",
          "parameters": {
            "row": "ETH",
            "column": "${CI_SONIC_SPC_SETUP_CHIP_TYPE}",
            "global_conf": "${MARS_GLOBAL_CONF}",
            "local_conf": "${MARS_LOCAL_CONF}",
            "setup_id": "${CI_SONIC_SPC_SETUP}",
            "setup_conf_file_path": "${MARS_CONF_BASE}/${CI_SONIC_SPC_SETUP}/",
            "base_version": "${SONIC_BIN}",
            "test_type": "CI",
            "mars_release_version": "${MARS_RELEASE_VERSION}",
            "sonic_mgmt_repo_url": "${nfs_dir}",
            "test_name": "test",
            "run_in_container": true
          },
          "skip": "${SKIP_SONIC_HW_SPC_BAT}",
          "on_failure": "stop",
          "out_of_mail": false
        },
        {
          "name": "Deploy SIMX SPC",
          "module": "/auto/sw_system_release/ci/sonic_devops/build/ci/bat.groovy",
          "category": "BAT",
          "container": "mini-mars:POD_MARS@SIMX_SPC",
          "parameters": {
            "row": "SIMX",
            "column": "${CI_SONIC_SIMX_SPC_SETUP_CHIP_TYPE}",
            "global_conf": "${MARS_GLOBAL_CONF}",
            "local_conf": "${MARS_LOCAL_CONF}",
            "setup_id": "${CI_SONIC_SIMX_SPC_SETUP}",
            "setup_conf_file_path": "${MARS_CONF_BASE}/${CI_SONIC_SIMX_SPC_SETUP}/",
            "base_version": "${SONIC_BIN}",
            "test_type": "CI",
            "sonic_mgmt_repo_url": "${nfs_dir}",
            "mars_release_version": "${MARS_RELEASE_VERSION}",
            "test_name": "deploy",
            "run_in_container": true
          },
          "skip": "${SKIP_SONIC_SIMX_SPC_BAT}",
          "on_failure": "${SIMX_ON_FAILURE}",
          "out_of_mail": false
        },
        {
          "name": "Test SIMX SPC",
          "module": "/auto/sw_system_release/ci/sonic_devops/build/ci/bat.groovy",
          "category": "BAT",
          "container": "mini-mars:POD_MARS@SIMX_SPC",
          "parameters": {
            "row": "SIMX",
            "column": "${CI_SONIC_SIMX_SPC_SETUP_CHIP_TYPE}",
            "global_conf": "${MARS_GLOBAL_CONF}",
            "local_conf": "${MARS_LOCAL_CONF}",
            "setup_id": "${CI_SONIC_SIMX_SPC_SETUP}",
            "setup_conf_file_path": "${MARS_CONF_BASE}/${CI_SONIC_SIMX_SPC_SETUP}/",
            "base_version": "${SONIC_BIN}",
            "test_type": "CI",
            "mars_release_version": "${MARS_RELEASE_VERSION}",
            "sonic_mgmt_repo_url": "${nfs_dir}",
            "test_name": "test",
            "run_in_container": true
          },
          "skip": "${SKIP_SONIC_SIMX_SPC_BAT}",
          "on_failure": "${SIMX_ON_FAILURE}",
          "out_of_mail": false
        },
        {
          "name": "Allocate setup AIR SPC",
          "module": "${nfs_dir}/general/build/smart_allocate_setup/smart_allocate_setup.groovy",
          "category": "Allocate setups",
          "container": "mini-mars:POD_MARS_AIR@AIR_SPC",
          "parameters": {
            "priority": "${PRIORITY_NUMBER}",
            "setup_var": "CI_SONIC_AIR_SPC_SETUP",
            "yaml_path": "${nfs_dir}/build/common/queue_air_info.yaml",
            "setup_requirements": "group_name:Sagi,sub_group:SONIC_AIR_CI,setup_status:enable"
          },
          "skip": "${SKIP_AIR}",
          "on_failure": "${AIR_ON_FAILURE}",
          "out_of_mail": true
        },
        {
          "name": "Deploy AIR SPC",
          "module": "/auto/sw_system_release/ci/sonic_devops/build/ci/bat.groovy",
          "category": "BAT",
          "container": "mini-mars:POD_MARS_AIR@AIR_SPC",
          "parameters": {
            "row": "AIR",
            "column": "${CI_SONIC_AIR_SPC_SETUP_CHIP_TYPE}",
            "global_conf": "${MARS_AIR_GLOBAL_CONF}",
            "local_conf": "${MARS_AIR_LOCAL_CONF}",
            "setup_id": "${CI_SONIC_AIR_SPC_SETUP}",
            "setup_conf_file_path": "/auto/sw_regression/system/SONIC/MARS/conf/setups/${CI_SONIC_AIR_SPC_SETUP}/",
            "base_version": "${SONIC_BIN}",
            "test_type" : "CI",
            "mars_release_version": "${MARS_RELEASE_VERSION}",
            "custom_tarball_name": "${nfs_dir}/${TARBALL_NAME}",
            "test_name": "deploy",
            "run_in_container": true
          },
          "skip": "${SKIP_AIR}",
          "on_failure": "${AIR_ON_FAILURE}",
          "out_of_mail": false
        },
        {
          "name": "Test AIR SPC",
          "module": "/auto/sw_system_release/ci/sonic_devops/build/ci/bat.groovy",
          "category": "BAT",
          "container": "mini-mars:POD_MARS_AIR@AIR_SPC",
          "parameters": {
            "row": "AIR",
            "column": "${CI_SONIC_AIR_SPC_SETUP_CHIP_TYPE}",
            "global_conf": "${MARS_AIR_GLOBAL_CONF}",
            "local_conf": "${MARS_AIR_LOCAL_CONF}",
            "setup_id": "${CI_SONIC_AIR_SPC_SETUP}",
            "setup_conf_file_path": "/auto/sw_regression/system/SONIC/MARS/conf/setups/${CI_SONIC_AIR_SPC_SETUP}/",
            "base_version": "${SONIC_BIN}",
            "test_type" : "CI",
            "mars_release_version": "${MARS_RELEASE_VERSION}",
            "custom_tarball_name": "${nfs_dir}/${TARBALL_NAME}",
            "repeat_mars": "${STABILITY}",
            "test_name": "test",
            "run_in_container": true
          },
          "skip": "${FAILED_DEPLOY_AIR_SPC} || ${SKIP_AIR}",
          "on_failure": "${AIR_ON_FAILURE}",
          "out_of_mail": false
        },
        {
          "name": "Deploy AIR SPC6 COMM T1",
          "module": "/auto/sw_system_release/ci/sonic_devops/build/ci/bat.groovy",
          "category": "BAT",
          "container": "mini-mars:POD_MARS_AIR@AIR_SPC6_COMM",
          "parameters": {
            "row": "AIR_COMMUNITY_T1",
            "column": "SPC6",
            "global_conf": "${MARS_AIR_GLOBAL_CONF}",
            "local_conf": "${MARS_AIR_LOCAL_CONF}",
            "setup_id": "${CI_SONIC_AIR_SPC6_COMM_SETUP}",
            "setup_conf_file_path": "/auto/sw_regression/system/SONIC/MARS/conf/setups/${CI_SONIC_AIR_SPC6_COMM_SETUP}/",
            "base_version": "${SONIC_BIN}",
            "test_type" : "CI",
            "mars_release_version": "${MARS_RELEASE_VERSION}",
            "test_name": "deploy",
            "run_in_container": true
          },
          "skip": "${SKIP_AIR}",
          "on_failure": "ignore",
          "out_of_mail": false
        },
        {
          "name": "Deploy AIR SPC6 COMM T0",
          "module": "/auto/sw_system_release/ci/sonic_devops/build/ci/bat.groovy",
          "category": "BAT",
          "container": "mini-mars:POD_MARS_AIR@AIR_SPC6_COMM_T0",
          "parameters": {
            "row": "AIR_COMMUNITY_T0",
            "column": "SPC6",
            "bat_extra_params": "--meinfo_topology t0-d96-u30s2",
            "global_conf": "${MARS_AIR_GLOBAL_CONF}",
            "local_conf": "${MARS_AIR_LOCAL_CONF}",
            "setup_id": "${CI_SONIC_AIR_SPC6_COMM_T0_SETUP}",
            "setup_conf_file_path": "/auto/sw_regression/system/SONIC/MARS/conf/setups/${CI_SONIC_AIR_SPC6_COMM_T0_SETUP}/",
            "base_version": "${SONIC_BIN}",
            "test_type" : "CI",
            "mars_release_version": "${MARS_RELEASE_VERSION}",
            "test_name": "deploy",
            "run_in_container": true
          },
          "skip": "${SKIP_AIR}",
          "on_failure": "ignore",
          "out_of_mail": false
        },
        {
          "name": "Deploy SmartSwitch",
          "module": "/auto/sw_system_release/ci/sonic_devops/build/ci/bat.groovy",
          "category": "BAT",
          "container": "mini-mars:POD_MARS@SS",
          "parameters": {
            "row": "SMARTSWITCH",
            "column": "SPC3/BF3",
            "global_conf": "${MARS_GLOBAL_CONF}",
            "local_conf": "${MARS_LOCAL_CONF}",
            "setup_id": "${CI_SONIC_SS_SETUP}",
            "setup_conf_file_path": "${MARS_CONF_BASE}/${CI_SONIC_SS_SETUP}/",
