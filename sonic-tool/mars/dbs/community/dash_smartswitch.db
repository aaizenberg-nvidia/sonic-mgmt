<?xml version="1.0" encoding="UTF-8"?>
<DBDEF>
    <global>
        <!-- parameters passed to setup steps commands-->
        <default_params_type> basic_setup_step_params </default_params_type>
        <DB>
            <info> DASH </info>
            <owner> SONiC </owner>
            <group> SONiC </group>

            <!-- OPTIONAL TAGS -->
            <tags> DASH </tags>

            <ignore>
                <condition>
                    <key> dut_hwsku </key>
                    <op> not in </op>
                    <value> [Mellanox-SN4280-O28, Mellanox-SN4280-O8C40] </value>
                </condition>
            </ignore>

            <!-- pre db commands - executed once before DB run -->
            <pre>
            </pre>
            <post></post>
        </DB>
        <Test>
            <!--Must reset any dynamic ignore tags created by other tests-->
            <pre>
                <type> reg_exec_func </type>
                <name> reset dynamic ignore tags </name>
                <mars_cmd_func> reset_dynamic_tags </mars_cmd_func>
                <tout> 60 </tout>
                <params>
                    <tags_type> ignore_tags </tags_type>
                </params>
            </pre>
            <post>
            </post>
        </Test>
        <Case>			<pre>
                <type> reg_exec_func </type>
                <name> set_environment_variables </name>
                <players_selection>
                    <ep_targets> SONIC_MGMT </ep_targets>
                </players_selection>
                <tout> 60 </tout>
                <params>
                    <env> MARS_CASE_NAME=[[run_time:mars_last_case_name]] </env>
                    <env> MARS_TEST_NAME=[[run_time:test_name]] </env>
                    <env> MARS_DB_NAME=[[run_time:db_name]] </env>
                </params>
</pre>

        </Case>
    </global>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/dash_eni_counter.cases </cases>
    </test>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/dash_private_link.cases </cases>
    </test>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/dash_pl_nsg.cases </cases>
    </test>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/dash_eni_based_forwarding.cases </cases>
    </test>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/dash_floating_nic_ecmp_trusted_vni.cases </cases>
    </test>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/dash_nasa_debug.cases </cases>
    </test>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/dash_smartswitch_vnet.cases </cases>
    </test>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/dash_config_churn.cases </cases>
    </test>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/dash_crm.cases </cases>
    </test>
</DBDEF>
