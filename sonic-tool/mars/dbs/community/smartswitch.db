<?xml version="1.0" encoding="UTF-8"?>
<DBDEF>
    <global>
        <!-- parameters passed to setup steps commands-->
        <default_params_type> basic_setup_step_params </default_params_type>
        <DB>
            <info> Smartswitch Tests </info>
            <owner> SONiC </owner>
            <group> SONiC </group>

            <!-- OPTIONAL TAGS -->
            <tags> SMARTSWITCH </tags>

            <ignore>
                <condition>
                    <key> dut_hwsku </key>
                    <op> not in </op>
                    <value> [Mellanox-SN4280-O28, Mellanox-SN4280-O8C40] </value>
                </condition>
            </ignore>

            <!-- pre db commands - executed once before DB run -->
            <pre>
            </pre>

            <!-- post db commands - executed once after DB run -->
            <post>
            </post>
        </DB>
        <Test>
            <!--Must reset any dynamic ignore tags created by other tests-->
            <pre>
                <type> reg_exec_func </type>
                <name> reset dynamic ignore tags </name>
                <mars_cmd_func> reset_dynamic_tags </mars_cmd_func>
                <tout> 60 </tout>
                <params>
                    <tags_type> ignore_tags </tags_type>
                </params>
            </pre>
            <pre>
                <name> enable NAT for DPU SSH access </name>
                <type> reg_exec_cmd </type>
                <tout> 300 </tout>
                <players_selection>
                    <ep_targets> SONIC_MGMT </ep_targets>
                </players_selection>
                <params>
                    <exec> PYTHONPATH=/devts/ /opt/venv/bin/pytest /root/mars/workspace/sonic-mgmt/tests/test_pretest_nat_dpu.py --setup_name=[[conf:extra_info.setup_name]] --log-cli-level debug --show-capture=no -ra --showlocals --timeout 300 --session-timeout 300 --rootdir=/root/mars/workspace/sonic-mgmt/tests --inventory="/root/mars/workspace/sonic-mgmt/ansible/inventory,/root/mars/workspace/sonic-mgmt/ansible/veos" --host-pattern [[conf:extra_info.dut_name]] --module-path /root/mars/workspace/sonic-mgmt/ansible/library/ --testbed [[conf:extra_info.dut_name]]-[[conf:extra_info.topology]] --testbed_file /root/mars/workspace/sonic-mgmt/ansible/testbed.yaml --disable_loganalyzer --skip_sanity </exec>
                </params>
            </pre>
            <post>
            </post>
        </Test>
        <Case>			<pre>
                <type> reg_exec_func </type>
                <name> set_environment_variables </name>
                <players_selection>
                    <ep_targets> SONIC_MGMT </ep_targets>
                </players_selection>
                <tout> 60 </tout>
                <params>
                    <env> MARS_CASE_NAME=[[run_time:mars_last_case_name]] </env>
                    <env> MARS_TEST_NAME=[[run_time:test_name]] </env>
                    <env> MARS_DB_NAME=[[run_time:db_name]] </env>
                </params>
</pre>

        </Case>
    </global>

    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/dpu_ip_assignment.cases </cases>
    </test>

    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/byo.cases </cases>
    </test>

    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/platform_smartswitch_only.cases </cases>
    </test>

    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/gnmi_smartswitch.cases </cases>
    </test>

</DBDEF>
