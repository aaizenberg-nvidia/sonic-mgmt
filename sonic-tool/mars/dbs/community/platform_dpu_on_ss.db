<?xml version="1.0" encoding="UTF-8"?>
<DBDEF>
    <global>
        <!-- parameters passed to setup steps commands-->
        <default_params_type> basic_setup_step_params </default_params_type>
        <DB>
            <info> Platform </info>
            <owner> SONiC </owner>
            <group> SONiC </group>

            <!-- OPTIONAL TAGS -->
            <tags> PLATFORM, SENSORS </tags>

            <ignore>
                <condition>
                    <key> dut_hwsku </key>
                    <op> not in </op>
                    <value> [Mellanox-SN4280-O28, Mellanox-SN4280-O8C40] </value>
                </condition>
            </ignore>

            <!-- pre db commands - executed once before DB run -->
            <!-- copy remote tests -->
            <pre>
            </pre>

            <!-- post db commands - executed once after DB run -->
            <post>
            </post>
        </DB>
        <Test>
            <!--Must reset any dynamic ignore tags created by other tests-->
            <pre>
                <type> reg_exec_func </type>
                <name> reset dynamic ignore tags </name>
                <mars_cmd_func> reset_dynamic_tags </mars_cmd_func>
                <tout> 60 </tout>
                <params>
                    <tags_type> ignore_tags </tags_type>
                </params>
            </pre>
            <pre>
                <type> reg_exec_func </type>
                <name> pre-test check </name>
                <mars_cmd_func> run_on_stm </mars_cmd_func>
                <tout> 300 </tout>
                <params>
                    <cmd> /root/pyenv/sonic/bin/python -E [[conf:execution_blocks.B_ID1.local_src_path]]/sonic-mgmt/sonic-tool/mars/scripts/pre_test_check.py </cmd>
                    <cmd_params> --topo [[conf:topology_file]] --test-name [[run_time:test_name]] --sonic-topo [[conf:extra_info.topology]] --workspace-path /root/mars/workspace --repo-name [[conf:extra_info.sonic_mgmt_repo_name]] </cmd_params>
                </params>
            </pre>
            <post>
            </post>
        </Test>
        <Case>			<pre>
                <type> reg_exec_func </type>
                <name> set_environment_variables </name>
                <players_selection>
                    <ep_targets> SONIC_MGMT </ep_targets>
                </players_selection>
                <tout> 60 </tout>
                <params>
                    <env> MARS_CASE_NAME=[[run_time:mars_last_case_name]] </env>
                    <env> MARS_TEST_NAME=[[run_time:test_name]] </env>
                    <env> MARS_DB_NAME=[[run_time:db_name]] </env>
                </params>
</pre>

        </Case>
    </global>

    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/platform_dpu_on_ss.cases </cases>
    </test>

    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/sensors_dpu_on_ss.cases </cases>
    </test>

</DBDEF>
