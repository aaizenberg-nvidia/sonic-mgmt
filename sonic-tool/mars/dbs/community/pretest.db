<?xml version="1.0" encoding="UTF-8"?>
<DBDEF>
    <global>
        <!-- parameters passed to setup steps commands-->
        <default_params_type> basic_setup_step_params </default_params_type>
        <DB>
            <info> PRE TEST </info>
            <owner> SONiC </owner>
            <group> SONiC </group>

            <!-- OPTIONAL TAGS -->
            <tags> PRE TEST </tags>

            <!-- pre db commands - executed once before DB run -->
            <pre>
            </pre>
            <post></post>
        </DB>
        <Test>
            <!--Must reset any dynamic ignore tags created by other tests-->
            <pre>
                <type> reg_exec_func </type>
                <name> reset dynamic ignore tags </name>
                <mars_cmd_func> reset_dynamic_tags </mars_cmd_func>
                <tout> 60 </tout>
                <params>
                    <tags_type> ignore_tags </tags_type>
                </params>
            </pre>
            <post>
            </post>
        </Test>
        <Case>			<pre>
                <type> reg_exec_func </type>
                <name> set_environment_variables </name>
                <players_selection>
                    <ep_targets> SONIC_MGMT </ep_targets>
                </players_selection>
                <tout> 60 </tout>
                <params>
                    <env> MARS_CASE_NAME=[[run_time:mars_last_case_name]] </env>
                    <env> MARS_TEST_NAME=[[run_time:test_name]] </env>
                    <env> MARS_DB_NAME=[[run_time:db_name]] </env>
                </params>
</pre>

        </Case>
    </global>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/fanout_upgrade.cases </cases>
    </test>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/common/log_analyzer_after_sonic_deploy.cases </cases>
    </test>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/pretest.cases </cases>
    </test>
    <test>
        <cases>
            sonic-mgmt/sonic-tool/mars/cases/community/pretest_dpu.cases
        </cases>
        <ignore>
            <condition>
                <key> base_version_dpu:(none) </key>
                <op> == </op>
                <value> none </value>
            </condition>
        </ignore>
    </test>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/common/cpld.cases </cases>
    </test>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/fanout_checker.cases </cases>
    </test>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/common/sdk_api.cases </cases>
    </test>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/common/secure_boot_checker.cases </cases>
    </test>
</DBDEF>
