<?xml version="1.0" encoding="UTF-8"?>
<DBDEF>
    <global>
        <!-- parameters passed to setup steps commands-->
        <default_params_type> basic_setup_step_params </default_params_type>
        <DB>
            <info> Resources </info>
            <owner> SONiC </owner>
            <group> SONiC </group>

            <!-- OPTIONAL TAGS -->
            <tags> SNMP, FDB, VLAN </tags>
            <ignore>
                <!-- weekend case  -->
                <condition>
                    <key> skip_weekend_cases </key>
                    <op> == </op>
                    <value> yes </value>
                </condition>
                <!-- Case only for main hwsku, skip this case if it is non-main hwsku -->
                <condition>
                    <key> skip_main_hwsku_only_cases </key>
                    <op> == </op>
                    <value> yes </value>
                </condition>
            </ignore>
            <!-- pre db commands - executed once before DB run -->
            <pre>
                <name> Deploy L2 mode </name>
                <type> reg_exec_cmd </type>
                <tout> 900 </tout>
                <run_posts_after_pre_failed> True </run_posts_after_pre_failed>
                <players_selection>
                    <ep_targets> SONIC_MGMT </ep_targets>
                </players_selection>
                <params>
                    <exec> PYTHONPATH=/devts/  /ngts_venv/bin/pytest /root/mars/workspace/sonic-mgmt/ngts/scripts/sonic_deploy/test_deploy_l2_mode.py::test_deploy_l2_mode --setup_name=[[conf:extra_info.setup_name]] --sonic-topo=[[conf:extra_info.topology]] --rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini  --log-level=INFO --clean-alluredir --alluredir=/tmp/allure-results --disable_loganalyzer </exec>
                </params>
            </pre>
            <post>
                <name> Restore default mode </name>
                <type> reg_exec_cmd </type>
                <tout> 900 </tout>
                <players_selection>
                    <ep_targets> SONIC_MGMT </ep_targets>
                </players_selection>
                <params>
                    <exec> PYTHONPATH=/devts/  /ngts_venv/bin/pytest /root/mars/workspace/sonic-mgmt/ngts/scripts/sonic_deploy/test_deploy_l2_mode.py::test_restore_default_mode --setup_name=[[conf:extra_info.setup_name]] --sonic-topo=[[conf:extra_info.topology]] --rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini  --log-level=INFO --clean-alluredir --alluredir=/tmp/allure-results --disable_loganalyzer </exec>
                </params>
            </post>
        </DB>
        <Test>
            <!--Must reset any dynamic ignore tags created by other tests-->
            <pre>
                <type> reg_exec_func </type>
                <name> reset dynamic ignore tags </name>
                <mars_cmd_func> reset_dynamic_tags </mars_cmd_func>
                <tout> 60 </tout>
                <params>
                    <tags_type> ignore_tags </tags_type>
                </params>
            </pre>
            <post>
            </post>
        </Test>
        <Case>			<pre>
                <type> reg_exec_func </type>
                <name> set_environment_variables </name>
                <players_selection>
                    <ep_targets> SONIC_MGMT </ep_targets>
                </players_selection>
                <tout> 60 </tout>
                <params>
                    <env> MARS_CASE_NAME=[[run_time:mars_last_case_name]] </env>
                    <env> MARS_TEST_NAME=[[run_time:test_name]] </env>
                    <env> MARS_DB_NAME=[[run_time:db_name]] </env>
                </params>
</pre>

        </Case>
    </global>
    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/arp_bsl.cases </cases>
    </test>

    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/fdb_bsl.cases </cases>
    </test>

    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/vlan_trunk_bsl.cases </cases>
    </test>

    <test>
        <cases> sonic-mgmt/sonic-tool/mars/cases/community/snmp_bsl.cases </cases>
    </test>

</DBDEF>
