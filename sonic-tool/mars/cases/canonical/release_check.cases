<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
  <global>
    <Test>
      <group> SONiC </group>
      <name> SONiC release check </name>
      <info> SONiC release check </info>
      <owner> amalkin </owner>
    </Test>
    <Case>
      <tags> release_check </tags>
      <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/canonical_mars_pytest_runner.py </wrapper>
      <tout> 90000 </tout>
      <tags>ALL</tags>
    </Case>
  </global>
  <case>
    <name> SSD </name>
    <info> </info>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests/push_build_tests/system --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --log-level=INFO --clean-alluredir --alluredir=/tmp/allure-results -m release_check --release_mode --showlocals --timeout 90000 --session-timeout 90000\'"</static_args>
      </params>
    </cmd>
  </case>
  <case>
    <name> SSD health </name>
    <info> </info>
    <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/community_mars_pytest_runner.py </wrapper>
    <cmd>
      <params>
          <static_args> --sonic-mgmt-dir /root/mars/workspace/[[conf:extra_info.sonic_mgmt_repo_name]] --dut-name [[conf:extra_info.dut_name]] --setup-name [[conf:extra_info.setup_name]] --sonic-topo [[conf:extra_info.topology]] --json-root-dir [[conf:extra_info.json_root_dir]] --pytest-tout-factor "[[conf:extra_info.pytest_tout_factor:*1]]" --test-scripts platform_tests/ssd/test_ssd_health.py --raw-options "\'--log-cli-level debug --show-capture=no -ra --showlocals --clean-alluredir --alluredir=/tmp/allure-results --ssd_stress_runtime=3600 --timeout 5400 --session-timeout 10800\'"</static_args>
      </params>
    </cmd>
  </case>

</CASEDEF>
