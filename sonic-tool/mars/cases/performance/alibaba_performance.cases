<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
  <global>
    <Test>
      <group> PERFORMANCE </group>
      <name> Alibaba performance tests </name>
      <info>  Alibaba performance tests  </info>
      <owner> shahafb </owner>
    </Test>
    <Case>
      <tags> performance </tags>
      <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/perf_mars_pytest_runner.py </wrapper>
      <tout> 43200 </tout>
      <tags>ALL</tags>
    </Case>
  </global>
  <case>
    <name> Alibaba leaf scenarios </name>
    <info> </info>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/performance_tests/alibaba_performance/alibaba_leaf_scenarios --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --log-level=INFO --clean-alluredir --alluredir=/tmp/allure-results --target_cli_type=[[conf:extra_info.target_cli_type]] --ignore-conditional-mark --showlocals -s --disable_loganalyzer\'"</static_args>
      </params>
    </cmd>
  </case>
</CASEDEF>
