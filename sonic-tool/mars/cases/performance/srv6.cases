<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
  <global>
    <Test>
      <group> PERFORMANCE </group>
      <name> MRC SRv6 tests </name>
      <info> MRC SRv6 tests  </info>
      <owner> slutati </owner>
    </Test>
    <Case>
      <tags> performance </tags>
      <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/perf_mars_pytest_runner.py </wrapper>
      <tout> 21600 </tout>
      <tags>ALL</tags>
    </Case>
  </global>
  <case>
    <name> SRv6 leaf tests </name>
    <info> SRv6 leaf tests </info>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/performance_tests/srv6/leaf/ --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --log-level=INFO --clean-alluredir --alluredir=/tmp/allure-results --target_cli_type=[[conf:extra_info.target_cli_type]] --showlocals  --ignore-conditional-mark --disable_loganalyzer --ignore=/root/mars/workspace/sonic-mgmt/ngts/performance_tests/srv6/leaf/test_srv6_leaf_calibration.py \'"</static_args>
      </params>
    </cmd>
  </case>
  <case>
    <name> SRv6 spine tests </name>
    <info> SRv6 spine tests </info>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/performance_tests/srv6/spine/ --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --log-level=INFO --clean-alluredir --alluredir=/tmp/allure-results --target_cli_type=[[conf:extra_info.target_cli_type]] --showlocals  -s --ignore-conditional-mark --disable_loganalyzer \'"</static_args>
      </params>
    </cmd>
  </case>
</CASEDEF>
