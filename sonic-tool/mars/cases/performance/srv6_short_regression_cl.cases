<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
  <global>
    <Test>
      <group> PERFORMANCE </group>
      <name> MRC SRv6 CL short regression </name>
      <info> MRC SRv6 CL short regression </info>
      <owner> yfass </owner>
    </Test>
    <Case>
      <tags> performance </tags>
      <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/perf_mars_pytest_runner.py </wrapper>
      <tout> 43200 </tout>
      <tags>ALL</tags>
    </Case>
  </global>
  <case>
    <name> srv6 cl short regression - TestSRv6Leaf </name>
    <info> One test per class, single hardcoded parametrize each </info>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/performance_tests/srv6/leaf/test_srv6_leaf.py::TestSRv6Leaf::test_bisection_srv6[False-SRv6-workload_1] --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --log-level=INFO --clean-alluredir --alluredir=/tmp/allure-results --target_cli_type=[[conf:extra_info.target_cli_type]] --showlocals --ignore-conditional-mark --disable_loganalyzer --ignore=/root/mars/workspace/sonic-mgmt/ngts/performance_tests/srv6/leaf/test_srv6_leaf_calibration.py\'"</static_args>
      </params>
    </cmd>
  </case>
  <case>
    <name> srv6 cl short regression - TestSRv6Spine </name>
    <info> One test per class, single hardcoded parametrize each </info>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/performance_tests/srv6/spine/test_srv6_spine.py::TestSRv6Spine::test_spine_srv6_trimming_many_to_few[4-IPv6-workload_1] --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --log-level=INFO --clean-alluredir --alluredir=/tmp/allure-results --target_cli_type=[[conf:extra_info.target_cli_type]] --showlocals -s --ignore-conditional-mark --disable_loganalyzer\'"</static_args>
      </params>
    </cmd>
  </case>
</CASEDEF>
