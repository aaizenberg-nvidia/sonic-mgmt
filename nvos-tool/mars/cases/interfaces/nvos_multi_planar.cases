<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
  <global>
    <Test>
      <group> NVOS </group>
      <name> NVOS multi planar tests </name>
      <info> </info>
      <owner> Liran Artzi </owner>
    </Test>
    <Case>
      <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/canonical_mars_pytest_runner.py </wrapper>
      <tout> 10800 </tout>
      <tags>ALL</tags>
    </Case>
  </global>

  <case>
    <name> symmetry manager and aggregated port </name>
    <info> </info>
    <tout> 10800 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/interfaces/multi_planar/test_multi_planar_sym_mgr_and_aport.py --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --release_name=[[conf:extra_info.release_name]] --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 900   \'"</static_args>
      </params>
    </cmd>
    <ignore>
      <condition>
        <key>dut_type</key>
        <op> in </op>
        <value>[juliet, rosalind, rosalind-surrogate, rosalind-chipless, portia]</value>
      </condition>
    </ignore>
  </case>

  <case>
    <name> split aggregated port test </name>
    <info> </info>
    <tout> 10800 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/interfaces/split_aggregated_port/test_split_aggregated_port.py --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --release_name=[[conf:extra_info.release_name]] --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 900   \'"</static_args>
      </params>
    </cmd>
    <ignore>
      <condition>
        <key>dut_type</key>
        <op> in </op>
        <value>[juliet, rosalind, rosalind-surrogate, rosalind-chipless, portia]</value>
      </condition>
    </ignore>
  </case>

  <case>
    <name> nvl5 port test </name>
    <info> </info>
    <tout> 10800 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/interfaces/nvl_port/test_nvl_port.py --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --release_name=[[conf:extra_info.release_name]] --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 1500   \'"</static_args>
      </params>
    </cmd>
    <ignore>
      <condition>
        <key>dut_type</key>
        <op> not in </op>
        <value>[juliet, rosalind, rosalind-surrogate, rosalind-chipless, portia]</value>
      </condition>
    </ignore>
  </case>

  <case>
    <name> mlxlink plane test </name>
    <info> </info>
    <tout> 10800 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/interfaces/test_ib_interface_planes.py --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --release_name=[[conf:extra_info.release_name]] --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 900   \'"</static_args>
      </params>
    </cmd>
    <ignore>
      <condition>
        <key>dut_type</key>
        <op> in </op>
        <value>[juliet, rosalind, rosalind-surrogate, rosalind-chipless, portia]</value>
      </condition>
    </ignore>
  </case>

  <case>
    <name> KR Configs </name>
    <info> </info>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/interfaces/test_kr_configs.py --raw_options "\' --rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir  --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 1200   \'"</static_args>
      </params>
    </cmd>
    <ignore>
      <condition>
        <key>dut_type</key>
        <op> not in </op>
        <value>[juliet, rosalind-surrogate, portia]</value>
      </condition>
    </ignore>
  </case>

  <case>
    <name> PLR Config </name>
    <info> </info>
    <cmd>
      <params>
        <static_args>
          --setup_name [[conf:extra_info.setup_name]]
          --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/interfaces/test_plr_configs.py
          --raw_options "\'
            --rootdir=/root/mars/workspace/sonic-mgmt/ngts
            -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini
            -k \"not test_feature_plr_cli_hidden_non_nvlink\"
            --log-level=INFO
            --default_pass_env_var=[[conf:extra_info.default_pass_env_var]]
            --clean-alluredir
            --alluredir=/tmp/allure-results
            --showlocals [[conf:extra_info.additional_options]]
            --timeout 600
          \'"
        </static_args>
      </params>
    </cmd>
  </case>

  <case>
    <name> PLR Counters and gNMI </name>
    <info> Validate 14 PLR CLI/JSON fields and four new gNMI leaves on five random active ACPs. </info>
    <cmd>
      <params>
        <static_args>
          --setup_name [[conf:extra_info.setup_name]]
          --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/interfaces/test_plr_counters.py
          --raw_options "\'
            --rootdir=/root/mars/workspace/sonic-mgmt/ngts
            -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini
            --log-level=INFO
            --default_pass_env_var=[[conf:extra_info.default_pass_env_var]]
            --clean-alluredir
            --alluredir=/tmp/allure-results
            --showlocals [[conf:extra_info.additional_options]]
            --timeout 600
          \'"
        </static_args>
      </params>
    </cmd>
  </case>

</CASEDEF>
