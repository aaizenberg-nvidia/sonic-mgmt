<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
  <global>
    <Test>
      <group> Cumulus </group>
      <name> Cumulus BMC </name>
      <info> BMC coverage for SPC6 / SN6810 / SN6800; skips cleanly where the DUT has no BMC. Excludes the firmware upgrade/downgrade stress loops - those live in cumulus_bmc_full.cases </info>
      <owner> Guy Paz Ben Itzhak </owner>
    </Test>
    <Case>
      <tags> BMC </tags>
      <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/canonical_mars_pytest_runner.py </wrapper>
      <tout> 10800 </tout>
      <tags>ALL</tags>
    </Case>
  </global>

  <case>
    <name> BMC Data Model NVUE vs Redfish </name>
    <info> Observed median 15s, slowest recorded run 21s </info>
    <tout> 3600 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/platform/test_bmc_data_model.py --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini -v -m \"cumulus and not stress\" --log-level=INFO --clean-alluredir  --alluredir=/tmp/allure-results  --disable_cli_coverage --disable_loganalyzer --showlocals  [[conf:extra_info.additional_options]]  --timeout 1800   \'"</static_args>
      </params>
    </cmd>
  </case>

  <case>
    <name> BMC usb0 Product Path </name>
    <info> Observed median 15s, slowest recorded run 21s </info>
    <tout> 3600 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/platform/test_bmc_usb0_product_path.py --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini -v -m \"cumulus and not stress\" --log-level=INFO --clean-alluredir  --alluredir=/tmp/allure-results  --disable_cli_coverage --disable_loganalyzer --showlocals  [[conf:extra_info.additional_options]]  --timeout 1800   \'"</static_args>
      </params>
    </cmd>
  </case>

