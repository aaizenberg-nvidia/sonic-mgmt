<?xml version="1.0" encoding="UTF-8" ?>
<CASEDEF>
  <global>
    <Test>
      <group> NVOS </group>
      <name> Platform CPO </name>
      <info> </info>
      <owner> Aleksander Romashin </owner>
    </Test>
    <Case>
      <tags> Platform CPO </tags>
      <wrapper> [[run_time:db_tests_path]]/sonic-mgmt/sonic-tool/mars/scripts/canonical_mars_pytest_runner.py </wrapper>
      <tout> 5400 </tout>
      <tags>ALL</tags>
    </Case>
  </global>

  <case>
    <name> CPO Show </name>
    <info> CPO, laser-source, interface and health show parity across NVUE, OpenAPI, gNMI and DB, plus topology consistency </info>
    <tout> 3600 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/platform/cpo/test_cpo_show.py --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir  --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 1800   \'"</static_args>
      </params>
    </cmd>
  </case>

  <case>
    <name> CPO Actions </name>
    <info> CPO, ELS and laser reset recovery, sw port link toggle, FAE dump-state and set/unset rejection with gNMI streaming </info>
    <tout> 5400 </tout>
    <cmd>
      <params>
          <static_args> --setup_name [[conf:extra_info.setup_name]] --test_script /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/platform/cpo/test_cpo_actions.py --raw_options "\'--rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini --log-level=INFO --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --clean-alluredir  --alluredir=/tmp/allure-results --showlocals  [[conf:extra_info.additional_options]]  --timeout 2700   \'"</static_args>
      </params>
    </cmd>
  </case>

</CASEDEF>
