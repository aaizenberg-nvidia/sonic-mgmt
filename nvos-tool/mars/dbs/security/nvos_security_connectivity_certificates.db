<?xml version='1.0' encoding='UTF-8'?>
<DBDEF>
	<global>
		<default_params_type> extended_setup_step_params </default_params_type>
		<DB>
			<info> Connectivity and Certificates Domain: gNMI, API, NMX, Certificates, NMX RBAC, CRL </info>
			<owner> Aleksander Romashin </owner>
			<group> NVOS </group>
			<dimension> VER </dimension>

            <pre>
            </pre>

		</DB>
		<Test>
			<post> </post>
		</Test>
		<Case>
            <pre>
                <type> reg_exec_func </type>
                <name> set_environment_variables </name>
                <players_selection>
                    <ep_targets> SONIC_MGMT </ep_targets>
                </players_selection>
                <tout> 60 </tout>
                <params>
                    <env> MARS_CASE_NAME=[[run_time:mars_last_case_name]] </env>
                    <env> MARS_TEST_NAME=[[run_time:test_name]] </env>
                    <env> MARS_DB_NAME=[[run_time:db_name]] </env>
                </params>
</pre>
			<post>
			</post>
            <on_not_success>
                <name> Failures post checker </name>
                <type> setup_mode </type>
                <cmd>
                    <type> reg_exec_cmd </type>
                    <players_selection>
                        <ep_targets> SONIC_MGMT </ep_targets>
                    </players_selection>
                    <name> on_failures_post_checker </name>
                    <tout> 900 </tout>
                    <params>
                        <exec> PYTHONPATH=/devts/ /ngts_venv/bin/pytest /root/mars/workspace/sonic-mgmt/ngts/tests_nvos/general/post_checker/test_post_checker.py  --setup_name=[[conf:extra_info.setup_name]]  --timeout 600 --default_pass_env_var=[[conf:extra_info.default_pass_env_var]] --session_id=[[run_time:session_id]]  --rootdir=/root/mars/workspace/sonic-mgmt/ngts -c /root/mars/workspace/sonic-mgmt/ngts/pytest.ini   --security_post_checker  --log-level=INFO --clean-alluredir --alluredir=/tmp/allure-results</exec>
                    </params>
                </cmd>
                <on_return_code>
                    <return_codes> 42 </return_codes>
                    <operation> exec_stop </operation>
                </on_return_code>
            </on_not_success>
		</Case>
	</global>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/security/cases/nvos_security_gnmi.cases </cases>
	</test>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/security/cases/nvos_security_api.cases </cases>
	</test>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/security/cases/nvos_security_nmx.cases </cases>
        <ignore><condition> <key>dut_type</key> <op> not in </op> <value>[juliet, rosalind, rosalind-surrogate, rosalind-chipless, portia]</value> </condition></ignore>
	</test>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/security/cases/nvos_security_certificates.cases </cases>
	</test>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/security/cases/nvos_security_nmx_rbac.cases </cases>
        <ignore><condition> <key>dut_type</key> <op> not in </op> <value>[juliet, rosalind, rosalind-surrogate, rosalind-chipless, portia]</value> </condition></ignore>
	</test>
    <test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/security/cases/nvos_security_nv_bridge_encryption.cases </cases>
        <ignore><condition> <key>dut_type</key> <op> not in </op> <value>[rosalind, rosalind-surrogate, rosalind-chipless]</value> </condition></ignore>
    </test>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/security/cases/nvos_security_uds_network_isolation.cases </cases>
        <ignore><condition> <key>dut_type</key> <op> not in </op> <value>[rosalind, rosalind-surrogate, rosalind-chipless]</value> </condition></ignore>
	</test>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/security/cases/nvos_security_crl.cases </cases>
	</test>
</DBDEF>
