<?xml version='1.0' encoding='UTF-8'?>
<DBDEF>
	<global>
		<default_params_type> extended_setup_step_params </default_params_type>
		<DB>
			<info> Cumulus BMC - full suite including the firmware upgrade/downgrade stress loops; requires a DUT with a BMC (SPC6 / SN6810 / SN6800) </info>
			<owner> Guy Paz Ben Itzhak </owner>
			<group> Cumulus </group>
			<dimension> VER </dimension>

            <pre>
            </pre>

		</DB>
		<Test>
			<post> </post>
		</Test>
		<Case>
            <pre>
                <type> reg_exec_func </type>
                <name> set_environment_variables </name>
                <players_selection>
                    <ep_targets> SONIC_MGMT </ep_targets>
                </players_selection>
                <tout> 60 </tout>
                <params>
                    <env> MARS_CASE_NAME=[[run_time:mars_last_case_name]] </env>
                    <env> MARS_TEST_NAME=[[run_time:test_name]] </env>
                    <env> MARS_DB_NAME=[[run_time:db_name]] </env>
                </params>
</pre>
			<post>
			</post>
		</Case>
	</global>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_bmc_full.cases </cases>
	</test>

</DBDEF>
