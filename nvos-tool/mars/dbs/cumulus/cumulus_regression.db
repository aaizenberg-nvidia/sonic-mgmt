<?xml version='1.0' encoding='UTF-8'?>
<DBDEF>
	<global>
		<default_params_type> extended_setup_step_params </default_params_type>
		<DB>
			<info> Cumulus Regression - All Cumulus Tests </info>
			<owner> Cumulus Team </owner>
			<group> Cumulus </group>
			<dimension> VER </dimension>

            <pre>
            </pre>

		</DB>
		<Test>
			<post> </post>
		</Test>
		<Case>
            <pre>
                <type> reg_exec_func </type>
                <name> set_environment_variables </name>
                <players_selection>
                    <ep_targets> SONIC_MGMT </ep_targets>
                </players_selection>
                <tout> 60 </tout>
                <params>
                    <env> MARS_CASE_NAME=[[run_time:mars_last_case_name]] </env>
                    <env> MARS_TEST_NAME=[[run_time:test_name]] </env>
                    <env> MARS_DB_NAME=[[run_time:db_name]] </env>
                </params>
</pre>
			<post>
			</post>
		</Case>
	</global>
	
	<!-- General Config Commands -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_general_config_commands.cases </cases>
	</test>
	
	<!-- System Tests -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_system.cases </cases>
	</test>
	
	<!-- ZTP Tests -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_ztp.cases </cases>
	</test>
	
	<!-- Platform Tests -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_platform.cases </cases>
	</test>
	
	<!-- Interface Tests -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_interfaces.cases </cases>
	</test>
	
	<!-- Infrastructure Tests -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_infra.cases </cases>
	</test>
	
	<!-- Security - AAA LDAP -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_security_test_aaa_ldap.cases </cases>
	</test>
	
	<!-- Security - Password Hardening -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_security_password_hardening.cases </cases>
	</test>
	
	<!-- Security - SSH Hardening -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_security_ssh_hardening.cases </cases>
	</test>
	
	<!-- Security - Login SSH Notification -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_security_login_ssh_notification.cases </cases>
	</test>
	
	<!-- Disconnect Action Tests -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_disconnect_action.cases </cases>
	</test>

	<!-- Security - SSH Ciphers Tests -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_security_ssh_ciphers.cases </cases>
	</test>

	<!-- Additional Cumulus Tests -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_additional_tests.cases </cases>
	</test>

	<!-- Fips Cumulus Tests -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_fips.cases </cases>
	</test>

	<!-- Stress Cumulus Tests -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_stress.cases </cases>
	</test>

	<!-- General Cumulus Tests -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_general.cases </cases>
	</test>

	<!-- SPC-6 Leakage Detection Tests -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_leakage.cases </cases>
	</test>

	<!-- BMC Tests -->
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/cumulus/cumulus_bmc.cases </cases>
	</test>

</DBDEF>

