<?xml version='1.0' encoding='UTF-8'?>
<DBDEF>
	<global>
		<default_params_type> extended_setup_step_params </default_params_type>
		<DB>
			<info> </info>
			<owner> Yana Port </owner>
			<group> NVOS </group>
			<dimension> VER </dimension>

            <pre>
            </pre>

		</DB>
		<Test>
			<post> </post>
		</Test>
		<Case>
            <pre>
                <type> reg_exec_func </type>
                <name> set_environment_variables </name>
                <players_selection>
                    <ep_targets> SONIC_MGMT </ep_targets>
                </players_selection>
                <tout> 60 </tout>
                <params>
                    <env> MARS_CASE_NAME=[[run_time:mars_last_case_name]] </env>
                    <env> MARS_TEST_NAME=[[run_time:test_name]] </env>
                    <env> MARS_DB_NAME=[[run_time:db_name]] </env>
                </params>
</pre>
			<post>
			</post>
		</Case>
	</global>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/CI/nvos_ci_nmx.cases </cases>
	</test>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/CI/nvos_ci_nvl5_interfaces.cases </cases>
	</test>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/CI/nvos_tech_support_expected_files.cases </cases>
	</test>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/interfaces/nvos_gnmi_nvl5.cases </cases>
	</test>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/CI/nvos_ci_nvl5_platform.cases </cases>
	</test>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/CI/nvos_ci_nmx_simulation.cases </cases>
	</test>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/CI/nvos_ci_init_flow_services_dockers.cases </cases>
	</test>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/CI/nvos_ci_sanity.cases </cases>
	</test>
	<test>
		<cases> sonic-mgmt/nvos-tool/mars/cases/CI/nvos_ci_cluster_app_mngr_security_cli.cases </cases>
	</test>

</DBDEF>