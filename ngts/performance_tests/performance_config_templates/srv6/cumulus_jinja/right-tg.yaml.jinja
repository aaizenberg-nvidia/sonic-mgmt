{% set port_list = filter_ports(["dut"]) %}
{% set split_right = parameter_dict.split_right %}
{% set split_left = parameter_dict.split_left %}
{% set total_ports = parameter_dict.total_ports %}
{% set dut_lldp_ports = port_list['dut'] %}
{% set mloop_lldp_ports = down_ports() %}
{% set dut_pre_split = cumulus_ports_match_requested_split(dut_lldp_ports, split_right) %}
{% set dut_pre_split_left = cumulus_ports_match_requested_split(dut_lldp_ports, split_left) %}
{% set mloop_pre_split = cumulus_ports_match_requested_split(mloop_lldp_ports, split_right) %}
{% set _ = validate_no_unsupported_service_port_split(dut_lldp_ports, split_right, "SRv6 right TG DUT-facing ports") %}
{% set _ = validate_no_unsupported_service_port_split(mloop_lldp_ports, split_right, "SRv6 right TG mloop ports") %}
{% set dut_parent_ports = get_swp_parent_port_names(dut_lldp_ports) %}
{% set mloop_parent_ports = get_swp_parent_port_names(mloop_lldp_ports) %}
{% set _ = validate_no_overlapping_swp_parent_ports(dut_lldp_ports, mloop_lldp_ports, "SRv6 right TG DUT-facing and mloop ports") %}
{% if parameter_dict.dut_left_ports_num is not none %}
{% set left_ports_num = parameter_dict.dut_left_ports_num %}
{% elif dut_pre_split_left %}
{% set left_ports_num = sort_swp_split_port_names(dut_lldp_ports)|length %}
{% else %}
{% set left_ports_num = get_swp_ports_for_split(dut_lldp_ports, split_left)|length %}
{% endif %}
{% if dut_pre_split %}
{% set dut_ports = sort_swp_split_port_names(dut_lldp_ports) %}
{% else %}
{% set dut_ports = get_swp_ports_for_split(dut_lldp_ports, split_right) %}
{% endif %}
{% if mloop_pre_split %}
{% set mloop_ports = sort_swp_split_port_names(mloop_lldp_ports) %}
{% else %}
{% set mloop_ports = get_swp_ports_for_split(mloop_lldp_ports, split_right) %}
{% endif %}
{% set dut_ports_num = dut_ports|length %}
{% set address_start = address_calculator(address = "fcbb:aaaa:2::1", operation = "add" , step = "0x100000000000000000000", operand = left_ports_num) %}
{% set address_list = generate_ip_address_list(address_start_v6 = address_start, mode="v6", step_v6="0x100000000000000000000", number_of_address=dut_ports_num) %}
{% set neighbor_start = address_calculator(address = "fcbb:aaaa:2::2", operation = "add" , step = "0x100000000000000000000", operand = left_ports_num) %}
{% set neighbor_list = generate_ip_address_list(address_start_v6 = neighbor_start, mode="v6", step_v6="0x100000000000000000000", number_of_address=dut_ports_num) %}
{% set speed = parameter_dict.speed | int %}
- header:
    model: sn5600
    nvue-api-version: nvue_v1
    rev-id: 1.0
    version: Cumulus Linux 5.15.0
- set:
    acl:
      acl-drop-arp-bgp:
        rule:
          '1':
            action:
              deny: {}
            match:
              mac:
                protocol: arp
          '2':
            action:
              deny: {}
            match:
              ip:
                protocol: 1
              mac:
                protocol: ipv4
          '3':
            action:
              deny: {}
            match:
              ip:
                protocol: 58
              mac:
                protocol: ipv6
          '4':
            action:
              deny: {}
            match:
              ip:
                protocol: 6
              mac:
                protocol: ipv4
          '5':
            action:
              deny: {}
            match:
              ip:
                protocol: 6
              mac:
                protocol: ipv6
          '6':
            action:
              permit: {}
        type: mac
    bridge:
      domain:
        br_default:
          stp:
            state:
              down: {}
          vlan:
            200-800: {}
    interface:
      eth0:
        ipv4:
          dhcp-client:
            state: enabled
            set-hostname: disabled
        vrf: mgmt
        type: eth
      lo:
        ipv6:
          address:
          {% for address in address_list%}
            {{ address | replace("aaaa", "bbbb") }}/48: {}
          {% endfor %}
        type: loopback
    {% if split_right | int != 1 %}
    {% for port in dut_parent_ports %}
      {{ port }}:
        link:
          breakout:
            {{ split_right }}x: {}
        type: swp
    {% endfor %}
    {% endif %}
    {% if split_right | int != 1 %}
    {% for port in mloop_parent_ports %}
      {{ port }}:
        link:
          breakout:
            {{ split_right }}x: {}
        type: swp
    {% endfor %}
    {% endif %}
    {% set counter = namespace(value=0) %}
    {% for port in dut_ports %}
      {{ port }}:
      {% if split_right | int == 1 %}
        link:
          breakout:
            1x: {}
          state:
            up: {}
        {% endif %}
        bridge:
          domain:
            br_default:
              access: {{ counter.value + 200 }}
              {% set counter.value = counter.value + 1 %}
              learning: disabled
        type: swp
    {% endfor %}
    {% set counter = namespace(value=0) %}
    {% for port in mloop_ports %}
      {{ port }}:
      {% if split_right | int == 1 %}
        link:
          breakout:
            1x: {}
          state:
            up: {}
      {% elif split_right | int == 8 and parameter_dict.get('link_phy_speed') %}
        link:
          speed: {{ parameter_dict.get('link_phy_speed') }}
        {% endif %}
        acl:
          acl-drop-arp-bgp:
            inbound: {}
        bridge:
          domain:
            br_default:
              access: {{ counter.value + 200 }}
              {% set counter.value = counter.value + 1 %}
              learning: disabled
        type: swp
    {% endfor %}
    {% for vlan in range(200, 200 + address_list|length ) %}
      vlan{{ vlan }}:
        base-interface: br_default
        ipv6:
          address:
            {{ address_list[loop.index0] }}/48: {}
        type: svi
        vlan: {{ vlan }}
    {% endfor %}
    system:
      aaa:
        user:
          cumulus:
            full-name: cumulus,,,
            hashed-password: $y$j9T$8zsfwM2wUFOqZ6Rf3R52N1$arVIQV7VMODDweBK.amymemQTvZmugDDW6rnEF.fHS3
            role: system-admin
      api:
        state: enabled
      config:
        auto-save:
          state: enabled
      control-plane:
        acl:
          acl-default-dos:
            inbound: {}
          acl-default-whitelist:
            inbound: {}
      hostname: right-tg
      ssh-server:
        max-sessions-per-connection: 30
        max-unauthenticated:
          throttle-start: 30
        permit-root-login: enabled
      wjh:
        channel:
          forwarding:
            trigger:
              l2: {}
              l3: {}
              tunnel: {}
        state: {% if parameter_dict.chip_type in ['SPC4', 'SPC6'] %}disabled{% else %}enabled{% endif %}
    router:
      bgp:
        autonomous-system: leaf
        router-id: 2.2.2.2
        state: enabled
      policy:
        prefix-list:
          {% for address in address_list %}
          neighbor_{{ loop.index }}:
            rule:
              '1':
                action: permit
                match:
                  {{ address | replace("aaaa", "bbbb") | replace("::1", "::/48") }}: {}
            type: ipv6
          {% endfor %}
        route-map:
          {% for address in address_list %}
          map_{{ loop.index }}:
            rule:
              '1':
                action:
                  permit: {}
                match:
                  ip-prefix-list: neighbor_{{ loop.index }}
                  type: ipv6
              '2':
                action:
                  deny: {}
                match:
                  source-protocol: connected
                  type: ipv6
          {% endfor %}
    vrf:
      default:
        router:
          bgp:
            address-family:
              ipv6-unicast:
                redistribute:
                  connected:
                    state: enabled
                state: enabled
            neighbor:
              {% for neighbor in neighbor_list %}
              {{ neighbor }}:
                address-family:
                  ipv6-unicast:
                    policy:
                      outbound:
                        route-map: map_{{ loop.index }}
                    state: enabled
                peer-group: dut
                type: numbered
                update-source: {{ address_list[loop.index0] }}
              {% endfor %}
            peer-group:
              dut:
                address-family:
                  ipv4-unicast:
                    state: disabled
                  ipv6-unicast:
                    state: enabled
                remote-as: external
            state: enabled
