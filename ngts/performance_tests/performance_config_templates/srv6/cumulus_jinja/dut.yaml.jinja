{% set left_lldp_ports = get_right_left_ports_dict(bring_up_ports=False)['left_ports'] %}
{% set right_lldp_ports = get_right_left_ports_dict(bring_up_ports=False)['right_ports'] %}
{% set split_left = parameter_dict.split_left %}
{% set split_right = parameter_dict.split_right %}
{% set total_ports = parameter_dict.total_ports %}
{% set pre_left = cumulus_ports_match_requested_split(left_lldp_ports, split_left) %}
{% set pre_right = cumulus_ports_match_requested_split(right_lldp_ports, split_right) %}
{% set _ = validate_no_unsupported_service_port_split(left_lldp_ports, split_left, "SRv6 DUT left ports") %}
{% set _ = validate_no_unsupported_service_port_split(right_lldp_ports, split_right, "SRv6 DUT right ports") %}
{% set left_parent_ports = get_swp_parent_port_names(left_lldp_ports) %}
{% set right_parent_ports = get_swp_parent_port_names(right_lldp_ports) %}
{% if pre_left %}
{% set left_ports = sort_swp_split_port_names(left_lldp_ports) %}
{% else %}
{% set left_ports = get_swp_ports_for_split(left_lldp_ports, split_left) %}
{% endif %}
{% if pre_right %}
{% set right_ports = sort_swp_split_port_names(right_lldp_ports) %}
{% else %}
{% set right_ports = get_swp_ports_for_split(right_lldp_ports, split_right) %}
{% endif %}
{% set left_ports_num = left_ports|length %}
{% set right_ports_num = right_ports|length %}
{% set address_list = generate_ip_address_list(address_start_v6="fcbb:aaaa:2::2", mode="v6", step_v6="0x100000000000000000000",number_of_address=(left_ports_num + right_ports_num)) %}
{% set neigbor_list_left = generate_ip_address_list(address_start_v6="fcbb:aaaa:2::1", mode="v6", step_v6="0x100000000000000000000",number_of_address=left_ports_num) %}
{% set neigbor_list_right_start = address_calculator(address = "fcbb:aaaa:2::1", operation = "add" , step = "0x100000000000000000000", operand = left_ports_num) %}
{% set neigbor_list_right = generate_ip_address_list(address_start_v6=neigbor_list_right_start, mode="v6", step_v6="0x100000000000000000000",number_of_address=right_ports_num) %}

- header:
    model: sn5600
    nvue-api-version: nvue_v1
    rev-id: 1.0
    version: Cumulus Linux 5.15.0   
- set:
    interface:
      eth0:
        ipv4:
          dhcp-client:
            state: enabled
            set-hostname: disabled
        vrf: mgmt
        type: eth
    {% if split_left | int != 1 %}
    {% for port in left_parent_ports %}
      {{ port }}:
        link:
          breakout:
            {{ split_left }}x: {}
        type: swp
    {% endfor %}
    {% endif %}
    {% if split_right | int != 1 %}
    {% for port in right_parent_ports %}
      {{ port }}:
        link:
          breakout:
            {{ split_right }}x: {}
        type: swp
    {% endfor %}
    {% endif %}
    {% set address_list_index = namespace(value=0) %}
    {% for port in left_ports %}
      {{ port }}:
      {% if split_left | int == 1 %}
        link:
          breakout:
            1x: {}
        {% endif %}
        ipv6:
          address:
            {{ address_list[address_list_index.value] }}/48 : {}
        {% set address_list_index.value = address_list_index.value + 1 %}
        type: swp
    {% endfor %}
    {% for port in right_ports %}
      {{ port }}:
      {% if split_right | int == 1 %}
        link:
          breakout:
            1x: {}
        {% endif %}
        ipv6:
          address:
            {{ address_list[address_list_index.value] }}/48 : {}
        {% set address_list_index.value = address_list_index.value + 1 %}
        type: swp
    {% endfor %}
    qos:
      roce:
        state: enabled
        mode: lossy-multi-tc
    router:
      bgp:
        autonomous-system: spine
        router-id: 3.3.3.3
        state: enabled
      segment-routing:
        srv6:
          locator:
            LOC1001:
              block-length: 32
              func-length: 0
              node-length: 16
              prefix: fcbb:bbbb:1::/48
          state: enabled
        static:
          srv6-sid:
            fcbb:bbbb:1::/48:
              behavior: uN
              locator-name: LOC1001
    system:
      aaa:
        user:
          cumulus:
            full-name: cumulus,,,
            hashed-password: $y$j9T$9Cyz6WM14RJ7pTBn3vhNC1$f9Yv..6j2M98TBcNXHsephQHAwnhCQ9XNg0Sy5f7NV8
            role: system-admin
      api:
        state: enabled
      config:
        auto-save:
          state: enabled
      control-plane:
        acl:
          acl-default-dos:
            inbound: {}
          acl-default-whitelist:
            inbound: {}
      hostname: dut
      ssh-server:
        state: enabled
        max-sessions-per-connection: 30
        max-unauthenticated:
          throttle-start: 30
        permit-root-login: enabled
      wjh:
        channel:
          forwarding:
            trigger:
              l1: {}
              l2: {}
              l3: {}
              tunnel: {}
        state: {% if parameter_dict.chip_type in ['SPC4', 'SPC6'] %}disabled{% else %}enabled{% endif %}
    vrf:
      default:
        router:
          bgp:
            address-family:
              ipv6-unicast:
                redistribute:
                  connected:
                    state: enabled
                state: enabled
            neighbor:
              {% for neighbor in neigbor_list_left %}
              {{ neighbor }}:
                address-family:
                  ipv6-unicast:
                    state: enabled
                peer-group: left_bgp
                type: numbered
                update-source: {{ address_list[loop.index0] }}
              {% endfor %}
            {% for neighbor in neigbor_list_right %}
              {{ neighbor }}:
                address-family:
                  ipv6-unicast:
                    state: enabled
                peer-group: right_bgp
                type: numbered
                update-source: {{ address_list[left_ports_num + loop.index0] }}
              {% endfor %}
            peer-group:
              left_bgp:
                address-family:
                  ipv4-unicast:
                    state: disabled
                  ipv6-unicast:
                    state: enabled
                remote-as: external
              right_bgp:
                address-family:
                  ipv4-unicast:
                    state: disabled
                  ipv6-unicast:
                    state: enabled
                remote-as: external
            state: enabled

