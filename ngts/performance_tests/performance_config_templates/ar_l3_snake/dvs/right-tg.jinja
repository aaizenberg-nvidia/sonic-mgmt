{
    "sdk_test_info": {
        "sdk_test_path": "sx_sdk_py_tests/tests/multi_os_tests/spcx_tests/spcx_ra_tg.py",
        "sdk_test_name": "SpcxTG"
    },
    "{{ PerfConsts.SDK_TEST_CONF }}": {
        {% set ports = right_left_ports_dict %}
        {% set right_ports = ports["right_ports"] %}
        {% set left_ports = ports["left_ports"] %}
        {% set all_ports = left_ports + right_ports %}
        "split_dict": { "{{ conf_args.split_right }}": {{ all_ports | tojson }} },
        "fws_base_vlan": 200,
        {# The snake sweeps both address families through its route families, so
           the TG's own link addressing stays IPv4. #}
        "is_ipv6": "False",
        "is_ipv4": "True",
        "shaper_val": "{{ conf_args.shaper_value }}",
        "key_un_fws": "un_fws_port_{}",
        "smac": "00:01:02:03:04:05",
        "left_mac": "00:01:02:03:04:06",
        "right_mac": "00:00:00:00:10:60",
        "source_ip": "4.4.4.4",
        "left_dst_ip": "10.0.1.0",
        "right_dst_ip": "192.168.1.0",
        "packet_size": {{ conf_args.packet_size }},
        "lossy_dscp_value": {{ conf_args.lossy_dscp_value }},
        "returned_mac_addr": ["00:00:00:00:10:70", "00:00:00:00:10:90"],
        "vlan": 5,
        {# MultiDipsTG walks the DIP one exact prefix per pass through the inject
           port, using one windowed rule per replicated route family. #}
        "dip_sweep_families": {{ conf_args.dip_sweep_families | tojson }},
        {# Empty unless the class runs the 100K-flow case: then every pass moves
           the UDP SPORT on and the DIP only moves when the SPORT wraps. #}
        "sport_sweep": {{ conf_args.sport_sweep | tojson }},
        "{{ PerfConsts.PORT_GROUPS }}": {{ get_player_unconnected_connected_after_split(conf_args.split_right) | tojson }}
    }
}
